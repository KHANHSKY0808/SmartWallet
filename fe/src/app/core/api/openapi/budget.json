          "categoryId",
          "month",
          "year"
        ],
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "maximum": 1000000000000,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "month": {
            "maximum": 12,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "year": {
            "maximum": 2100,
            "minimum": 2000,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "UpdateBudgetRequest": {
        "required": [
          "amount"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "maximum": 1000000000000,
            "minimum": 0.01,
