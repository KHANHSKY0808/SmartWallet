{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:8000",
  "Jwt": {
    "SigningKey": ""
  },
  "ReverseProxy": {
    "Routes": {
      "auth-public-login": {
        "ClusterId": "identity-cluster",
        "Order": 1,
        "Match": { "Path": "/api/auth/login" }
      },
      "auth-public-register": {
        "ClusterId": "identity-cluster",
        "Order": 1,
        "Match": { "Path": "/api/auth/register" }
      },
      "auth-public-refresh": {
        "ClusterId": "identity-cluster",
        "Order": 1,
        "Match": { "Path": "/api/auth/refresh" }
      },
      "auth-public-forgot-password": {
        "ClusterId": "identity-cluster",
        "Order": 1,
        "Match": { "Path": "/api/auth/forgot-password" }
      },
      "auth-public-reset-password": {
        "ClusterId": "identity-cluster",
        "Order": 1,
        "Match": { "Path": "/api/auth/reset-password" }
      },
      "auth-public-confirm-email": {
        "ClusterId": "identity-cluster",
        "Order": 1,
        "Match": { "Path": "/api/auth/confirm-email" }
      },
      "auth-protected-route": {
        "ClusterId": "identity-cluster",
        "Order": 2,
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "profile-route": {
        "ClusterId": "profile-cluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/api/profile/{**catch-all}" }
      },
      "wallet-route": {
        "ClusterId": "wallet-cluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/api/wallets/{**catch-all}" }
      },
      "tx-route": {
        "ClusterId": "transaction-cluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/api/transactions/{**catch-all}" }
      },
      "category-route": {
        "ClusterId": "category-cluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/api/categories/{**catch-all}" }
      },
      "budget-route": {
        "ClusterId": "budget-cluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/api/budgets/{**catch-all}" }
      },
      "saving-route": {
        "ClusterId": "saving-cluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/api/savings/{**catch-all}" }
      },
      "recurring-route": {
        "ClusterId": "recurring-cluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/api/recurring/{**catch-all}" }
      },
      "debt-route": {
        "ClusterId": "debt-cluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/api/debts/{**catch-all}" }
      },
      "report-route": {
        "ClusterId": "report-cluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/api/reports/{**catch-all}" }
      },
      "notif-route": {
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "audit-route": {
        "ClusterId": "audit-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": { "Path": "/api/audit/{**catch-all}" }
      },
      "file-route": {
        "ClusterId": "file-cluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/api/files/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": { "d1": { "Address": "http://localhost:8001" } }
      },
      "profile-cluster": {
        "Destinations": { "d1": { "Address": "http://localhost:8002" } }
      },
      "wallet-cluster": {
        "Destinations": { "d1": { "Address": "http://localhost:8003" } }
      },
      "transaction-cluster": {
        "Destinations": { "d1": { "Address": "http://localhost:8004" } }
      },
      "category-cluster": {
        "Destinations": { "d1": { "Address": "http://localhost:8005" } }
      },
      "budget-cluster": {
        "Destinations": { "d1": { "Address": "http://localhost:8006" } }
      },
      "saving-cluster": {
        "Destinations": { "d1": { "Address": "http://localhost:8007" } }
      },
      "recurring-cluster": {
        "Destinations": { "d1": { "Address": "http://localhost:8008" } }
      },
      "debt-cluster": {
        "Destinations": { "d1": { "Address": "http://localhost:8008" } }
      },
      "report-cluster": {
        "Destinations": { "d1": { "Address": "http://localhost:8009" } }
      },
      "notification-cluster": {
        "Destinations": { "d1": { "Address": "http://localhost:8010" } }
      },
      "audit-cluster": {
        "Destinations": { "d1": { "Address": "http://localhost:8011" } }
      },
      "file-cluster": {
        "Destinations": { "d1": { "Address": "http://localhost:8012" } }
      }
    }
  }
}
