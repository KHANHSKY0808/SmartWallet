# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG PROJECT_PATH
ARG ASSEMBLY_NAME
WORKDIR /src

COPY SmartWallet.sln ./
COPY src/Shared/SharedKernel/SharedKernel.csproj src/Shared/SharedKernel/
COPY ${PROJECT_PATH}/${ASSEMBLY_NAME}.csproj ${PROJECT_PATH}/
RUN dotnet restore "${PROJECT_PATH}/${ASSEMBLY_NAME}.csproj"

COPY src/Shared/SharedKernel/ src/Shared/SharedKernel/
COPY ${PROJECT_PATH}/ ${PROJECT_PATH}/
RUN dotnet publish "${PROJECT_PATH}/${ASSEMBLY_NAME}.csproj" -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
ARG ASSEMBLY_NAME
ARG PORT=8080
ENV ASPNETCORE_URLS="http://0.0.0.0:${PORT}" \
    Urls="http://0.0.0.0:${PORT}" \
    DOTNET_RUNNING_IN_CONTAINER=true \
    Backup__Directory=/backups

RUN apt-get update && apt-get install -y --no-install-recommends curl libfontconfig1 libfreetype6 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 appuser \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin appuser \
    && mkdir -p /app /data /backups /tmp/smartwallet-imports /tmp/smartwallet-exports \
    && chown -R appuser:appuser /app /data /backups /tmp/smartwallet-imports /tmp/smartwallet-exports

WORKDIR /app
COPY --from=build --chown=appuser:appuser /app/publish ./
USER appuser

ENV ENTRY_DLL="${ASSEMBLY_NAME}.dll"
EXPOSE ${PORT}
ENTRYPOINT ["sh", "-c", "exec dotnet \"/app/${ENTRY_DLL}\""]
