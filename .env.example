# Biến môi trường mẫu cho SmartWallet (QLCT-SOA) - KHÔNG commit tệp .env thật
# BẮT BUỘC điền giá trị thực (tối thiểu 32 ký tự cho JWT_SIGNING_KEY) trước khi chạy docker compose (N50)
JWT_SIGNING_KEY=
SEED_ADMIN_EMAIL=admin@smartwallet.local
SEED_ADMIN_PASSWORD=
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=no-reply@smartwallet.local
SMTP_USER=
SMTP_PASS=
REDIS_CONNECTION=redis:6379
CONSUL_HOST=http://consul:8500
BACKUP_DIRECTORY=/backups

