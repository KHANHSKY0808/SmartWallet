  "components": {
    "schemas": {
      "CreateTagRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "color": {
            "maxLength": 20,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateTransactionRequest": {
        "required": [
          "walletId"
        ],
        "type": "object",
        "properties": {
          "walletId": {
            "type": "string",
            "format": "uuid"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "type": {
            "maximum": 2,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "amount": {
            "maximum": 1000000000000,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "transactionDate": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "maxLength": 1000,
            "type": "string",
            "nullable": true
          },
          "receiptFileId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "tagIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ReassignCategoryRequest": {
        "required": [
          "oldCategoryId",
          "replacementCategoryId"
        ],
        "type": "object",
        "properties": {
          "oldCategoryId": {
            "type": "string",
            "format": "uuid"
          },
          "replacementCategoryId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "UpdateTransactionRequest": {
        "required": [
          "rowVersion",
          "walletId"
        ],
        "type": "object",
        "properties": {
          "walletId": {
            "type": "string",
            "format": "uuid"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "type": {
            "maximum": 2,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "amount": {
            "maximum": 1000000000000,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "transactionDate": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "maxLength": 1000,
            "type": "string",
            "nullable": true
          },
          "receiptFileId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "tagIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "nullable": true
          },
          "rowVersion": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      }
